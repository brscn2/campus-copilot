# --- Bedrock (inference profile ARNs or model IDs) ---
BEDROCK_REGION=eu-central-1
BEDROCK_SONNET_MODEL_ID=anthropic.claude-sonnet-4-6-20250514-v1:0
BEDROCK_HAIKU_MODEL_ID=anthropic.claude-haiku-4-5-20251001-v1:0

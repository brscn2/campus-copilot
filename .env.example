# --- Cognee ---
COGNEE_API_KEY=cog_EXAMPLE_KEY
COGNEE_API_URL=https://api.cognee.ai
COGNEE_DATASET_PREFIX=course_

# --- TUM Moodle Scraper ---
TUM_USERNAME=go42tum
TUM_PASSWORD=your_tum_password
MOODLE_HEADLESS=1
MOODLE_SESSION_DIR=.sessions
MOODLE_DOWNLOAD_DIR=downloads
MOODLE_EXTRACT_DIR=extracted

# --- Quiz ---
QUIZ_STORAGE_DIR=.quiz_cache
